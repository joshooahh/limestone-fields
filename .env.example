# Sanity (public identifiers) and the server token used by the form routes
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_TOKEN=

# Email (Resend)
RESEND_API_KEY=
CONTACT_EMAIL=

# Field Notes newsletter (Mailchimp Marketing API). Set these in Vercel, never in git.
# MAILCHIMP_SERVER_PREFIX is the part of the API key after the dash (for example us2).
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=
